# Consistency Engine environment configuration.
# Safe placeholders only. Never commit real credentials.
# Every variable the process reads is listed here. Unset values use the defaults below.

# Data-source mode: synthetic | replay | kalshi_authorized
DATA_SOURCE=synthetic

# The Kalshi adapter is refused unless BOTH flags are true AND the operator has
# obtained the required authorization under Kalshi's Developer Agreement.
ENABLE_KALSHI_API=false
KALSHI_AUTHORIZATION_CONFIRMED=false

# Live Kalshi collection. Leave blank. Point KALSHI_PRIVATE_KEY_PATH at a PEM
# file outside the repository. Do not paste the key here.
KALSHI_ENVIRONMENT=production
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_REST_BASE_URL=
KALSHI_WS_URL=
KALSHI_MARKET_LIMIT=20
KALSHI_PAGE_LIMIT=100
KALSHI_MAX_PAGES=5
KALSHI_SERIES_TICKERS=
KALSHI_HTTP_TIMEOUT_S=10
KALSHI_MAX_RETRIES=5
KALSHI_READ_CONCURRENCY=2
KALSHI_REQUEST_TOKEN_COST=10
KALSHI_READ_TOKEN_BUDGET=200
KALSHI_ORDERBOOK_BATCH_SIZE=100
KALSHI_MIN_REQUEST_INTERVAL_S=0.05
KALSHI_WS_QUEUE_MAX=256
KALSHI_RECONNECT_BASE_S=0.5
KALSHI_RECONNECT_MAX_S=30
KALSHI_RECONNECT_ATTEMPTS=8
KALSHI_PING_INTERVAL_S=10
KALSHI_PONG_TIMEOUT_S=10
KALSHI_METADATA_REFRESH_S=300
KALSHI_BOOK_COMPARE_S=60
KALSHI_COMPARE_SKEW_MS=2000
KALSHI_DISCOVERY_INTERVAL_S=3600
KALSHI_INCLUDE_MVE=false
KALSHI_MEMBER_CLASS=
KALSHI_INTERMEDIARY_FEES=unknown
KALSHI_FEE_SCHEDULE_REVISIONS_CHECKED=false
STUDY_ID=
STUDY_START=
STUDY_END=
# Opt-in live smoke. CI must leave this unset.
KALSHI_LIVE_SMOKE=

# Live trading is out of scope. Startup refuses true.
ENABLE_LIVE_TRADING=false

# Replay mode: path to a dataset directory (see fixtures/datasets/).
REPLAY_DATASET_PATH=fixtures/datasets/smoke

# Synthetic mode
SYNTHETIC_SEED=20260115
SYNTHETIC_PLAYBACK_SPEED=1.0
SYNTHETIC_PRESET=inconsistent
# When false, the latest session for a fingerprint decides. A latest completed
# session is not ingested again. A later failed or interrupted reseed is
# resumed and does not open another id. true, or
# `python -m consistency_worker run --reseed`, allocates a new session when
# the latest one already completed.
RESEED_SESSION=false

# Reference data
FEE_SCHEDULE_DIR=fixtures/fees
RELATIONSHIP_REVIEWS_PATH=fixtures/relationships/manual-reviews.yaml

# Database. Host tests use compose.host-db.yml (project consistency-engine).
# If port 5432 is taken, start with POSTGRES_PORT=5433 and point DATABASE_URL
# at 127.0.0.1:5433. The Phase 15 stack is docker-compose.yml (project
# consistency-deploy). Inside that stack the URL host is db, and Postgres is
# not published. The password below is the local placeholder, not a secret.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://consistency:consistency@127.0.0.1:5432/consistency

# Raw order-book persistence. Synthetic and replay record by default.
# Third-party sources (Kalshi) record raw books only when the flag below is true.
PERSIST_MARKET_DATA=true
THIRD_PARTY_RAW_PERSISTENCE_AUTHORIZED=false
RETENTION_MAX_AGE_HOURS=168
RETENTION_MAX_SESSIONS=20
RETENTION_THIRD_PARTY_HOURS=0
RETENTION_INTERVAL_S=3600
# `python -m consistency_worker maintain` applies this interval. The worker
# entrypoint starts that process and keeps it after ingestion finishes.
# The maintain process also rewrites MAINTENANCE_HEARTBEAT_PATH every
# MAINTENANCE_HEARTBEAT_S seconds. With EXPECT_MAINTENANCE=1, `health` exits 1
# if that file is missing or older than MAINTENANCE_STALE_S, even when the
# last ingestion session is completed. A failed ingestion stays failed.
# Compose sets EXPECT_MAINTENANCE=1 on the worker. Leave it unset for a host
# `health` command that only reports the ingestion session.
EXPECT_MAINTENANCE=0
MAINTENANCE_HEARTBEAT_PATH=/tmp/consistency-worker/heartbeat
MAINTENANCE_STALE_S=30
MAINTENANCE_HEARTBEAT_S=5
# Consecutive retention cycles that raise. Health is unhealthy when this count
# is greater than MAINTENANCE_MAX_FAILURES, even if the process is alive and
# the heartbeat timestamp is fresh. A finished cycle resets the count and
# records last_success. The default threshold is 3.
MAINTENANCE_MAX_FAILURES=3
# A live process is unhealthy when last_success is older than this many
# seconds. The default retention interval is 3600, so 7200 allows one delayed
# cycle. Startup grace covers the wait before the first cycle: the retention
# task sleeps for RETENTION_INTERVAL_S before that cycle. 3660 is that
# interval plus 60 seconds. A stale last_success is unhealthy even during
# the grace window. If MAINTENANCE_STARTUP_GRACE_S is unset, health uses
# RETENTION_INTERVAL_S + 60.
MAINTENANCE_SUCCESS_MAX_AGE_S=7200
MAINTENANCE_STARTUP_GRACE_S=3660
# Newest commit-safe notification ids maintenance keeps. The consumer watermark
# is the contiguous outbox watermark. Ids at or below watermark - this value
# may be deleted, never an id above the watermark. A Last-Event-ID inside the
# retained suffix is replayed. A cursor at or below the stored floor is an SSE
# resync from detection rows, which this job does not delete. 10000 is larger
# than the bundled inconsistent session's detection events, so a normal
# synthetic run does not prune a live cursor, and the table stays bounded.
OUTBOX_RETENTION_KEEP=10000
JOURNAL_BATCH_SIZE=500
CHECKPOINT_EVERY=2000

# Pipeline queues and the worker restart budget
SWEEP_INTERVAL_MS=100
OUTBOX_MAXSIZE=1024
UPDATE_QUEUE_MAXSIZE=10000
INBOUND_QUEUE_MAXSIZE=10000
HEARTBEAT_TIMEOUT_S=10
SUPERVISOR_MAX_RESTARTS=8
SUPERVISOR_BACKOFF_BASE_S=0.5
SUPERVISOR_BACKOFF_MAX_S=30

# Logging. One JSON object per line. Tokens, passwords, and database URL
# passwords are redacted.
LOG_LEVEL=INFO

# Public API. Health probes are exempt from the rate limit and the request timeout.
API_HOST=0.0.0.0
API_PORT=8000
API_REQUEST_TIMEOUT_S=30
API_RATE_LIMIT=240
API_RATE_WINDOW_S=60
# Distinct client identities stored by the in-process limiter. Expired entries
# are dropped. A new identity past this cap is 429 and is not stored.
API_RATE_MAX_CLIENTS=4096
# X-Forwarded-For is ignored unless COUNT is >= 1 and the TCP peer is listed
# in TRUSTED_PROXIES (comma-separated exact addresses, not ranges). The client
# is then the address COUNT hops from the right. A left-hand prefix is not a
# new bucket. Leave both unset (0 and empty) on a direct local deployment.
TRUSTED_PROXY_COUNT=0
TRUSTED_PROXIES=
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Dashboard. The Next server calls the internal gateway. The browser polls Next.
# Replay mutations need X-Replay-Token on the gateway hop only. The browser
# receives an httpOnly capability cookie, not this token.
# Leave REPLAY_MUTATIONS_PUBLIC false.
REPLAY_API_TOKEN=local-replay-token
REPLAY_MUTATIONS_PUBLIC=false
# Idle viewers are dropped after this many seconds. Playing viewers that are
# still polled stay. Abandoned playback tasks are cancelled.
# Viewer cursors live in the API process that opened them. A second process
# or a restart does not share those cursors. The recording in PostgreSQL does.
REPLAY_SESSION_TTL_S=1800
REPLAY_MAX_VIEWERS=32
# In-flight reconstructions of a recording that is not already an open viewer.
REPLAY_MAX_PREVIEWS=4
# httpOnly dashboard capability lifetime, in seconds. Not the shared REPLAY_API_TOKEN.
REPLAY_CAPABILITY_TTL_S=900
# Outstanding capabilities and issuance rate. Expired entries are removed first.
REPLAY_CAPABILITY_MAX=256
REPLAY_CAPABILITY_ISSUE_LIMIT=30
REPLAY_CAPABILITY_ISSUE_WINDOW_S=60
# Per-client cap inside the global window. One client cannot take the whole
# budget. Without TRUSTED_PROXY_COUNT and TRUSTED_PROXIES, every issuer shares
# the key "direct", so rotating X-Forwarded-For does not open a new bucket.
# The header is also ignored unless the immediate TCP peer is listed in
# TRUSTED_PROXIES. A route Request with no socket has no peer, so the header
# stays ignored. Expired client keys are dropped. At most this many client
# identities are stored; a new one past the cap is 429 and is not stored.
REPLAY_CAPABILITY_CLIENT_LIMIT=5
REPLAY_CAPABILITY_MAX_CLIENTS=4096
# Set to 1 to mark the capability cookie Secure. HTTPS requests set Secure
# without this flag. Leave unset for http://127.0.0.1.
REPLAY_COOKIE_SECURE=0

# SSE tail. A full queue closes the slow client; it reconnects with Last-Event-ID.
SSE_MAX_CONNECTIONS=32
SSE_HEARTBEAT_SECONDS=15
SSE_QUEUE_MAX=32

WEB_PORT=3000
DASHBOARD_GATEWAY_HOST=127.0.0.1
DASHBOARD_GATEWAY_PORT=8765
DASHBOARD_GATEWAY_URL=http://127.0.0.1:8765

# Benchmark guard. Default off. Port 5432 and any non-loopback host are refused
# unless the matching flag is exactly 1. These do not start a deployment.
BENCHMARK_ALLOW_PORT_5432=0
BENCHMARK_ALLOW_REMOTE=0
